{
  "manifest_version": 3,
  "key": "",
  "name": "Zorgdomein Infused",
  "description": "Snelkoppelingen naar ZorgDomein-formulieren: standalone of vanuit je HIS (o.a. Bricks Infused).",
  "version": "1.0.0",
  "version_name": "v1.0.0 29-09-2026",
  "author": "Dokter Bart",
  "homepage_url": "https://dokterbart.nl/",
  "icons": {
    "16": "zorgdomein-16.png",
    "32": "zorgdomein-32.png",
    "48": "zorgdomein-48.png",
    "128": "zorgdomein-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zorgdomein Infused"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "externally_connectable": {
    "ids": [
      "ebannlcfcakhaekmbeogkphbijghepbe",
      "mogkemhemedhcmoopdlfdjklgjlhgmnp",
      "maggacdmiigkoockdjdekdkflfochgbl"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zorgdomein.nl/dashboard*",
        "https://www.zorgdomein.nl/healthcare-request/*",
        "https://www.zorgdomein.nl/supply-matcher/*"
      ],
      "js": ["content_zd_dash.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.zorgdomein.nl/dashboard*",
        "https://www.zorgdomein.nl/supply-matcher/*",
        "https://www.zorgdomein.nl/protocol/*",
        "https://www.zorgdomein.nl/choose-product/*",
        "https://www.zorgdomein.nl/referral/*"
      ],
      "js": ["content_zd_common.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["zorgdomein.svg"],
      "matches": ["https://www.zorgdomein.nl/*"]
    }
  ]
}
